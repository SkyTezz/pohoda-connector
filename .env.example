# --- POHODA mServer (required) -------------------------------------------
POHODA_URL=http://192.168.1.10:444
POHODA_USERNAME=aurea-connector
POHODA_PASSWORD=
POHODA_ICO=12345678
POHODA_TIMEOUT=120000
POHODA_MAX_RETRIES=2

# --- Write policy ---------------------------------------------------------
# approval = every write becomes a proposal a human approves (default)
# direct   = pass-through; refused unless CONNECTOR_SANDBOX=true
CONNECTOR_WRITE_MODE=approval
CONNECTOR_ALLOW_DELETE=false
CONNECTOR_AUTO_SEND_ON_APPROVE=true
# true only on a test accounting unit: lets agents/services approve
CONNECTOR_SANDBOX=false
# exSystemName written into every document's extId + dataPack id prefix
CONNECTOR_EXT_SYSTEM=AUREA

# --- Proposal store -------------------------------------------------------
CONNECTOR_STORE=sqlite
CONNECTOR_SQLITE_PATH=./data/connector.sqlite
# or keep proposals next to POHODA on the same SQL Server (own database!):
# CONNECTOR_STORE=mssql
# CONNECTOR_STORE_MSSQL_SERVER=192.168.1.10
# CONNECTOR_STORE_MSSQL_PORT=1433
# CONNECTOR_STORE_MSSQL_DATABASE=PohodaConnector
# CONNECTOR_STORE_MSSQL_USER=connector_rw
# CONNECTOR_STORE_MSSQL_PASSWORD=
# CONNECTOR_STORE_MSSQL_ENCRYPT=false
# CONNECTOR_STORE_MSSQL_TRUST_CERT=true

# --- Read-only SQL access to the accounting unit (optional) ---------------
# Login must be SELECT-only on StwPh_<ICO>_<year>; re-grant after POHODA upgrades.
POHODA_SQL_SERVER=192.168.1.10
POHODA_SQL_PORT=1433
POHODA_SQL_DATABASE=StwPh_12345678_2026
POHODA_SQL_USER=aurea_ro
POHODA_SQL_PASSWORD=
POHODA_SQL_ENCRYPT=false
POHODA_SQL_TRUST_CERT=true
POHODA_SQL_MAX_ROWS=1000

# --- Transport ------------------------------------------------------------
# stdio (MCP over stdin/stdout, one principal from env) or http (MCP + REST, bearer tokens)
CONNECTOR_TRANSPORT=stdio
CONNECTOR_PRINCIPAL_NAME=claude
CONNECTOR_PRINCIPAL_ROLE=agent
CONNECTOR_HTTP_HOST=127.0.0.1
CONNECTOR_HTTP_PORT=8444
# Required when CONNECTOR_HTTP_HOST is not loopback: Host header values allowed (DNS-rebinding protection)
CONNECTOR_HTTP_ALLOWED_HOSTS=
CONNECTOR_HTTP_MAX_SESSIONS=50
CONNECTOR_HTTP_SESSION_IDLE_MINUTES=30
# {"<token>": {"name": "...", "role": "agent|human|service"}} — tokens >= 32 chars, generate with: openssl rand -hex 32
CONNECTOR_TOKENS={"replace-with-openssl-rand-hex-32-output-agent-0000":{"name":"claude","role":"agent"},"replace-with-openssl-rand-hex-32-output-human-0000":{"name":"interni-operator","role":"human"},"replace-with-openssl-rand-hex-32-output-svc-00000":{"name":"interni-worker","role":"service"}}
