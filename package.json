{
  "name": "pohoda-connector",
  "version": "2.0.0",
  "description": "Universal POHODA connector: mServer XML writes behind human approval with idempotent replay, read-only SQL access, MCP + REST for AI agents and backends",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pohoda-connector": "dist/index.js"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "author": "SkyTezz (fork of hlebtkachenko/pohoda-mcp)",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkyTezz/pohoda-connector.git"
  },
  "homepage": "https://github.com/SkyTezz/pohoda-connector",
  "bugs": {
    "url": "https://github.com/SkyTezz/pohoda-connector/issues"
  },
  "keywords": ["pohoda", "stormware", "accounting", "mcp", "xml-api", "mserver", "approval", "connector"],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-dictionary": "node scripts/sync-dictionary.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "fast-xml-parser": "^5.2.0",
    "iconv-lite": "^0.6.3",
    "mssql": "^11.0.1",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
